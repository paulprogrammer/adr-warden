{
  "name": "adr-warden",
  "version": "1.0.1",
  "description": "Deterministic vector overlap guard and decision lineage knowledge graph for Architecture Decision Records",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "bin": {
    "warden": "./dist/cli.js",
    "adr-warden": "./dist/cli.js"
  },
  "files": [
    "dist",
    "skills"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "clean": "rimraf dist",
    "build": "rimraf dist && tsc && chmod +x dist/cli.js",
    "test": "vitest run",
    "prepublishOnly": "pnpm build && pnpm test",
    "start": "node dist/cli.js",
    "mcp": "node dist/cli.js mcp"
  },
  "keywords": [
    "adr",
    "architecture-decision-records",
    "mcp",
    "model-context-protocol",
    "vector-search",
    "knowledge-graph"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/paulprogrammer/adr-warden.git"
  },
  "homepage": "https://github.com/paulprogrammer/adr-warden#readme",
  "bugs": {
    "url": "https://github.com/paulprogrammer/adr-warden/issues"
  },
  "author": "Paul Williams <paulprogrammer@gmail.com>",
  "license": "MIT",
  "packageManager": "pnpm@11.10.0",
  "type": "module",
  "dependencies": {
    "@huggingface/transformers": "^4.2.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "rimraf": "^6.1.3",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
